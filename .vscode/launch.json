{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[LAB 1] Start",
            "type": "debugpy",
            "request": "launch",
            "program": "lab_1_classify_profile/start.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[SEMINAR 2] Learn debug",
            "type": "debugpy",
            "request": "launch",
            "program": "seminars/listing_1_run_debug.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[SEMINAR 2] Learn int",
            "type": "debugpy",
            "request": "launch",
            "program": "seminars/listing_2_integers.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[SEMINAR 3] Learn if",
            "type": "debugpy",
            "request": "launch",
            "program": "seminars/listing_3_conditions.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[SEMINAR 3] Learn str",
            "type": "debugpy",
            "request": "launch",
            "program": "seminars/listing_4_strings.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[ADMIN] Run tests",
            "type": "debugpy",
            "request": "launch",
            "module": "quality_control.run_tests",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args":[
                "--pr-name", "test",
                "--pr-author", "test"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[ADMIN] Run spelling",
            "type": "debugpy",
            "request": "launch",
            "module": "quality_control.spellcheck.check_spelling",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args":[],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[ADMIN] Sort spelling dictionaries",
            "type": "debugpy",
            "request": "launch",
            "module": "quality_control.spellcheck.sort_wordlist",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args":[],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[ADMIN] Check coverage",
            "type": "debugpy",
            "request": "launch",
            "module": "quality_control.collect_coverage.coverage_analyzer",
            "args": [],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "[ADMIN] Update forks",
            "type": "debugpy",
            "request": "launch",
            "program": "quality_control.github.update_forks",
            "args": [
                "--config", "config/github/update_fork_config.json"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
